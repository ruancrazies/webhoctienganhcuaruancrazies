# Sao chép thành .env.local (KHÔNG commit). Biến không có NEXT_PUBLIC_ chỉ dùng phía server.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Chuỗi kết nối Postgres cho content:sync / content:export (KHÔNG dùng cho ứng dụng) ---
# Supabase > Project Settings > Database > Connection string (direct hoặc session pooler).
# Local mặc định (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_LOCAL=
DATABASE_URL_STAGING=
DATABASE_URL_PROD=

# --- Gửi mail xác nhận (Send Email Hook -> Apps Script) ---
SEND_EMAIL_HOOK_SECRET=
# Tạo secret bằng: npm run auth:secrets
# SEND_EMAIL_HOOK_SECRET có dạng v1,whsec_... (Supabase Dashboard > Authentication > Hooks > Send Email)
# MAIL_WEBHOOK_URL là URL web app Apps Script (.../exec); xem docs/buoc-3-dang-nhap.md
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# (Tùy chọn, dự phòng) Có RESEND_API_KEY thì gửi bằng Resend thay cho Apps Script
RESEND_API_KEY=
RESEND_FROM=
# Trần số mail/ngày của TOÀN hệ thống (chặn làm cạn hạn mức). Để trống: 90 với Apps Script/Gmail, 1000 với Resend.
MAIL_GLOBAL_PER_DAY=

# --- CAPTCHA đăng nhập/đăng ký/quên mật khẩu (Cloudflare Turnstile, miễn phí) ---
# Tạo widget tại https://dash.cloudflare.com/?to=/:account/turnstile (thêm domain Vercel của bạn).
# Cần CẢ HAI biến; để trống = tắt CAPTCHA. Thử local: site key 1x00000000000000000000AA + secret 1x0000000000000000000000000000000AA (luôn pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# PRODUCTION: khuyến nghị bật CAPTCHA ngay trong Supabase (Dashboard > Authentication > Attack Protection > Turnstile,
# dán Secret key) rồi đặt biến này = true. Khi đó Supabase tự xác minh token, nên kẻ gọi thẳng /auth/v1/* bằng
# publishable key cũng bị chặn. (Token chỉ dùng được một lần: ở chế độ này server không tự gọi siteverify nữa.)
SUPABASE_CAPTCHA_ENABLED=
# Production mà thiếu TURNSTILE_SECRET_KEY thì server TỪ CHỐI đăng nhập/đăng ký. Chỉ đặt true nếu cố ý tắt CAPTCHA.
CAPTCHA_DISABLED=

# --- Nội dung (Google Sheet) ---
# ID nằm trong URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# Có giá trị này thì nó ghi đè sheetId trong content/sheet.config.json
CONTENT_SHEET_ID=
# Chỉ cần khi Sheet KHÔNG công khai "ai có link: chỉ đọc" (chưa hỗ trợ ở Bước 0)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Chung ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (SAU) ảnh/âm thanh trên R2
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Trò chuyện với thú cưng (Gemini). Lấy khóa tại https://aistudio.google.com/apikey — chỉ dùng phía server ---
GEMINI_API_KEY=
# (Tùy chọn) mặc định gemini-3.5-flash-lite
GEMINI_MODEL=
